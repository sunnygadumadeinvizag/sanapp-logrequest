# IIPE App5 (Log Request) — local development environment
DATABASE_URL="postgresql://app5_user:app5_dev_password@localhost:5432/app5_db"

# Public URLs
SSO_BASE_URL="http://localhost:3000"
MAIN_BASE_URL="http://localhost:3001"
APP_BASE_URL="http://localhost:3006"

# OIDC client registration (must match the SSO seed)
APP_CLIENT_ID="iipe-app5"
APP_CLIENT_SECRET="app5_dev_client_secret"

# Shared key presented to Main when asking about application access
# (must match Main's MAIN_API_KEY)
MAIN_API_KEY="iipe_main_api_dev_key_5e8c"

# Shared key to call the SSO admin API for user lookup (on-behalf requests)
# (must match SSO's SSO_ADMIN_KEY)
SSO_ADMIN_KEY="iipe_admin_dev_key_a1b2c3"

# Secret for this application's own session cookie (HS256)
APP_SESSION_SECRET="app5_session_dev_secret_2f8a4b77"
COOKIE_SECURE="false"
